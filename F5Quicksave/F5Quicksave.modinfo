<?xml version="1.0" encoding="utf-8"?>
<Mod id="48b282ae-71d1-42af-be6d-529cfa89e407" version="4">
  <Properties>
    <Name>F5 Quicksave</Name>
    <Stability>Alpha</Stability>
    <Teaser>Press F5 to quicksave; Social Policies moves to Ctrl+F5</Teaser>
    <Description>Press F5 to save the game as "F5 QuickSave". The game's own F5, the Social Policies screen, moves to Ctrl+F5 so the two do not clash.</Description>
    <Authors>spradlin-dev</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
  <Dependencies />
  <References />
  <Blocks />
  <Files>
    <File import="0">F5Quicksave.lua</File>
    <File import="0">XML/Controls.xml</File>
  </Files>
  <Actions>
    <OnModActivated>
      <UpdateDatabase>XML/Controls.xml</UpdateDatabase>
    </OnModActivated>
  </Actions>
  <EntryPoints>
    <EntryPoint type="InGameUIAddin" file="F5Quicksave.lua">
      <Name>F5Quicksave</Name>
      <Description>load all contexts</Description>
    </EntryPoint>
  </EntryPoints>
</Mod>