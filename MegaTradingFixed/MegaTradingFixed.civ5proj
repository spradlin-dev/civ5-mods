<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{0d1dc5bb-a19c-451a-9f5f-9da5b8496e62}</ProjectGuid>
    <Name>Mega Trading (Additional Trade Routes) (Fixed)</Name>
    <Guid>70ce6d29-1af7-443e-9bcf-229045f8b59e</Guid>
    <ModVersion>2</ModVersion>
    <Stability>Beta</Stability>
    <Teaser>The original Mega Trading, made to work: many more trade routes from Harbors, Colossus, Petra, the East India Company and Globalization.</Teaser>
    <Description>Mega Trading (Additional Trade Routes) by Hypergloss, with the same numbers, made to work with the current game. Each Harbor gives 3 extra trade routes, each Caravansary 1, Colossus and Petra 10 each, the East India Company 100, and researching Globalization 94. Requires Brave New World. Do not enable the original at the same time.</Description>
    <Authors>Jason Spradlin</Authors>
    <SpecialThanks>Hypergloss, for the original Mega Trading</SpecialThanks>
    <HideSetupGame>false</HideSetupGame>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <AssemblyName>MegaTradingFixed</AssemblyName>
    <RootNamespace>MegaTradingFixed</RootNamespace>
    <ModDependencies>
      <Association>
        <Type>Dlc</Type>
        <Name>Expansion - Brave New World</Name>
        <Id>6DA07636-4123-4018-B643-6575B4EC336B</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers>
      <Association>
        <Type>Mod</Type>
        <Name>Mega Trading (Additional Trade Routes)</Name>
        <Id>06762e63-eb8a-4bb2-b2f9-01b849788fec</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModBlockers>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>XML\TradeRoutes.xml</FileName>
      </Action>
    </ModActions>
    <ModContent />
    <ModProperties>
    </ModProperties>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' ">
    <PackageMod>true</PackageMod>
    <DeployMod>false</DeployMod>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' ">
    <PackageMod>false</PackageMod>
    <DeployMod>true</DeployMod>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="XML\TradeRoutes.xml">
      <SubType>Lua</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="XML\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>
