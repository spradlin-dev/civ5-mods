      <Content>
        <Type>InGameUIAddin</Type>
        <Name>AutoCycleUnitShortcut</Name>
        <Description>Loads the shortcut</Description>
        <FileName>AutoCycleUnitShortcut.lua</FileName>
      </Content>
    </ModContent>
    <ModProperties>
    </ModProperties>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
