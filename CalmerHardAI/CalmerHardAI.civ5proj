<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{6f101f08-1858-4ab3-96ed-eb080566de90}</ProjectGuid>
    <Name>Calmer AI on Hard Difficulties</Name>
    <Guid>12e96e01-8f98-43fe-882a-47badee4d41e</Guid>
    <ModVersion>1</ModVersion>
    <Stability>Beta</Stability>
    <Teaser>Less constant war from the AI on Emperor, Immortal and Deity.</Teaser>
    <Description>On Emperor, Immortal and Deity the AI's bigger armies make it judge a war against you as a good bet far more often. This mod lowers every AI's appetite for war against human players on those levels: to 70% on Emperor, 60% on Immortal and 50% on Deity of what it would be otherwise. Lower levels are unchanged, and so are wars between AI civilizations. Requires Brave New World.</Description>
    <Authors>Jason Spradlin</Authors>
    <SpecialThanks />
    <HideSetupGame>false</HideSetupGame>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <AssemblyName>CalmerHardAI</AssemblyName>
    <RootNamespace>CalmerHardAI</RootNamespace>
    <ModDependencies>
      <Association>
        <Type>Dlc</Type>
        <Name>Expansion - Brave New World</Name>
        <Id>6DA07636-4123-4018-B643-6575B4EC336B</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>XML\Handicaps.xml</FileName>
      </Action>
    </ModActions>
    <ModContent />
    <ModProperties>
    </ModProperties>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' ">
    <PackageMod>true</PackageMod>
    <DeployMod>false</DeployMod>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' ">
    <PackageMod>false</PackageMod>
    <DeployMod>true</DeployMod>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="XML\Handicaps.xml">
      <SubType>Lua</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="XML\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>
